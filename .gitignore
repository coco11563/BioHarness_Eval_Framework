# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual envs
.venv/
venv/
env/
# `.python-version` is committed as a runtime hint; do not ignore it.

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
.cache/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Local datasets (must be downloaded; do not commit)
data/
.cache/huggingface/

# `output/` is generally user-runs (do not commit), but we ship the
# canonical headline run snapshot under output/pipeline/ so that verify.py
# works out of the box. Ignore everything else.
output/*
!output/pipeline/

# Local secrets
.env
.env.local
secrets/

# uv
uv.lock-old
.uv-cache/
